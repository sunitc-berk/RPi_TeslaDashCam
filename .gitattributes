# Normalise line endings: LF in the repo; shell and Python files must be LF on the Pi
* text=auto
*.sh text eol=lf
*.py text eol=lf
*.service text eol=lf
*.timer text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.woff2 binary
*.ico binary
